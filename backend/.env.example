APP_NAME=AskLake FastAPI Backend
APP_ENV=local
API_PREFIX=/api
DATABASE_URL=postgresql+psycopg://asklake:asklake_dev@localhost:54328/asklake
LOCAL_LAKE_STORAGE_DIR=
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OPENAI_API_KEY=
OPENAI_ASSISTANT_ENABLED=true
OPENAI_ASSISTANT_MODEL=gpt-4o-mini
OPENAI_ASSISTANT_MAX_OUTPUT_TOKENS=1200
OPENAI_ASSISTANT_MAX_SAMPLE_ROWS=5
OPENAI_ASSISTANT_TIMEOUT_SECONDS=20
OPENAI_QUERY_AI_MODEL=gpt-4.1-mini

# Local OpenAI-compatible LLM used by temporary row-by-row review analysis.
# LM Studio default: http://127.0.0.1:1234/v1/chat/completions
ASKLAKE_REVIEW_ANALYSIS_RUNTIME=local_llm
ASKLAKE_LOCAL_LLM_ENDPOINT=http://127.0.0.1:1234/v1/chat/completions
ASKLAKE_LOCAL_LLM_ENDPOINT_IN_DOCKER=http://host.docker.internal:1234/v1/chat/completions
ASKLAKE_LOCAL_LLM_MODEL=local-review-analyzer
ASKLAKE_LOCAL_LLM_TIMEOUT_SECONDS=120
ASKLAKE_LOCAL_LLM_MAX_INPUT_CHARS=9000

# Spark-backed Parquet schema/sample inspection. Cold local Spark startup can
# take longer than 30 seconds even for a small bounded preview.
ASKLAKE_SOURCE_INSPECT_TIMEOUT_MS=90000

# SQL Preview reads Catalog s3:// or s3a:// Parquet through the server-side
# S3 client, caches it only for the lifetime of one query, and refuses a query
# before download when the combined object size exceeds this byte limit.
ASKLAKE_OBJECT_STORAGE_PROVIDER=minio
ASKLAKE_RAW_BUCKET=m3-raw
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=asklake-output
MINIO_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9000
S3_FORCE_PATH_STYLE=true
S3_ALLOWED_BUCKETS=asklake-output
ASKLAKE_SQL_PREVIEW_MAX_REMOTE_BYTES=536870912

# Airflow orchestration. Leave AIRFLOW_API_BASE_URL empty unless a local or
# external Airflow API is available.
AIRFLOW_API_BASE_URL=
AIRFLOW_DAG_ID=asklake_etl_job
AIRFLOW_UI_BASE_URL=
AIRFLOW_API_TOKEN=
AIRFLOW_USERNAME=
AIRFLOW_PASSWORD=
AIRFLOW_REQUEST_TIMEOUT_SECONDS=10
AIRFLOW_EXECUTION_API_TOKEN=asklake-local-airflow-execution
AIRFLOW_INTERNAL_TOKEN=asklake-local-airflow-token

# Kafka Continuous control-plane synchronization and finite maintenance lease.
ASKLAKE_KAFKA_BROKER=127.0.0.1:19092
ASKLAKE_KAFKA_SAMPLE_TIMEOUT_MS=8000
ASKLAKE_KAFKA_SAMPLE_IDLE_MS=500
ASKLAKE_KAFKA_SAMPLE_MIN_MESSAGES=3
ASKLAKE_KAFKA_SAMPLE_SETTLE_MS=1500
CONTINUOUS_RUNTIME_SYNC_INTERVAL_SECONDS=5
ASKLAKE_CONTINUOUS_MAINTENANCE_LEASE_SECONDS=900
# Test harness only: fail one worker attempt after durable data and before its manifest.
ASKLAKE_CONTINUOUS_FAIL_AFTER_DATA_WRITE_ONCE=false
