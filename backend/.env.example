APP_NAME=AskLake FastAPI Backend
APP_ENV=local
API_PREFIX=/api
DATABASE_URL=postgresql+psycopg://asklake:asklake_dev@localhost:54328/asklake
LOCAL_LAKE_STORAGE_DIR=
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=AskLake Administrator
# Production defaults to administrator-provisioned accounts only.
AUTH_PUBLIC_SIGNUP_ENABLED=false
OPENAI_API_KEY=
OPENAI_ASSISTANT_ENABLED=true
OPENAI_ASSISTANT_MODEL=gpt-4o-mini
OPENAI_ASSISTANT_MAX_OUTPUT_TOKENS=1200
OPENAI_ASSISTANT_MAX_SAMPLE_ROWS=5
OPENAI_ASSISTANT_TIMEOUT_SECONDS=20
OPENAI_QUERY_AI_MODEL=gpt-4.1-mini

# Local OpenAI-compatible LLM used by temporary row-by-row review analysis.
# LM Studio default: http://127.0.0.1:1234/v1/chat/completions
ASKLAKE_REVIEW_ANALYSIS_RUNTIME=local_llm
ASKLAKE_LOCAL_LLM_ENDPOINT=http://127.0.0.1:1234/v1/chat/completions
ASKLAKE_LOCAL_LLM_ENDPOINT_IN_DOCKER=http://host.docker.internal:1234/v1/chat/completions
ASKLAKE_LOCAL_LLM_MODEL=local-review-analyzer
ASKLAKE_LOCAL_LLM_TIMEOUT_SECONDS=120
ASKLAKE_LOCAL_LLM_MAX_INPUT_CHARS=9000

# Spark-backed Parquet schema/sample inspection. Cold local Spark startup can
# take longer than 30 seconds even for a small bounded preview.
# Local batch execution defaults to Docker. Set the canonical runtime explicitly
# for Kafka Continuous and maintenance. ASKLAKE_SPARK_RUNNER remains a legacy alias.
ASKLAKE_SPARK_RUNTIME=
ASKLAKE_SPARK_RUNNER=
ASKLAKE_SOURCE_INSPECT_TIMEOUT_MS=90000

# Optional EMR Serverless runtime. Batch uses the common entry point below.
# Phase 5 Continuous is a second opt-in block and requires Amazon MSK IAM plus
# S3 checkpoint/output. Authentication uses execution/instance roles; never put
# access keys or session tokens in this file.
ASKLAKE_EMR_SERVERLESS_ENABLED=false
ASKLAKE_EMR_SERVERLESS_APPLICATION_ID=
ASKLAKE_EMR_SERVERLESS_EXECUTION_ROLE_ARN=
ASKLAKE_EMR_SERVERLESS_ENTRY_POINT_URI=
ASKLAKE_EMR_SERVERLESS_ARTIFACT_URI=
ASKLAKE_EMR_SERVERLESS_LOG_URI=
ASKLAKE_EMR_SERVERLESS_POLL_INTERVAL_MS=2000
ASKLAKE_EMR_SERVERLESS_EXECUTION_TIMEOUT_MINUTES=120
ASKLAKE_EMR_SERVERLESS_CANCEL_GRACE_SECONDS=120
ASKLAKE_EMR_SERVERLESS_DRIVER_CORES=1
ASKLAKE_EMR_SERVERLESS_DRIVER_MEMORY=4g
ASKLAKE_EMR_SERVERLESS_EXECUTOR_CORES=2
ASKLAKE_EMR_SERVERLESS_EXECUTOR_MEMORY=4g
ASKLAKE_EMR_SERVERLESS_MIN_EXECUTORS=0
ASKLAKE_EMR_SERVERLESS_INITIAL_EXECUTORS=1
ASKLAKE_EMR_SERVERLESS_MAX_EXECUTORS=10
# STREAMING Job Runs require EMR 7.1+, but AskLake graceful pause/stop requires
# EMR 7.9+. Empty application and entry-point values fall back to common values.
# The streaming worker has no execution timeout and uses retry thrash prevention.
ASKLAKE_EMR_SERVERLESS_CONTINUOUS_ENABLED=false
ASKLAKE_EMR_SERVERLESS_CONTINUOUS_APPLICATION_ID=
ASKLAKE_EMR_SERVERLESS_CONTINUOUS_ENTRY_POINT_URI=
ASKLAKE_EMR_SERVERLESS_CONTINUOUS_ENTRY_POINT_FILE=
ASKLAKE_EMR_SERVERLESS_CONTINUOUS_PYFILES_URIS=
ASKLAKE_EMR_SERVERLESS_CONTINUOUS_MAX_FAILED_ATTEMPTS_PER_HOUR=5
# packages requires private-subnet NAT/Maven egress and explicit acknowledgement.
# jars avoids runtime Maven resolution and requires immutable, checksum-verified
# Kafka connector plus transitive dependency S3 URIs.
ASKLAKE_EMR_SERVERLESS_CONTINUOUS_DEPENDENCY_MODE=packages
ASKLAKE_EMR_SERVERLESS_CONTINUOUS_ALLOW_MAVEN_EGRESS=false
ASKLAKE_EMR_SERVERLESS_CONTINUOUS_JAR_URIS=
ASKLAKE_EMR_SERVERLESS_CONTINUOUS_KAFKA_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.5
ASKLAKE_EMR_SERVERLESS_CONTINUOUS_MSK_IAM_PACKAGE=software.amazon.msk:aws-msk-iam-auth:2.3.6

# SQL Preview reads Catalog s3:// or s3a:// Parquet through the server-side
# S3 client, caches it only for the lifetime of one query, and refuses a query
# before download when the combined object size exceeds this byte limit.
ASKLAKE_OBJECT_STORAGE_PROVIDER=minio
ASKLAKE_RAW_BUCKET=m3-raw
ASKLAKE_SPARK_OUTPUT_BUCKET=asklake-output
# Storage Layout V1. Logical paths are provider-neutral; retention values are
# policy metadata and must be mirrored by the bucket lifecycle configuration.
ASKLAKE_STORAGE_BASE_PREFIX=asklake
ASKLAKE_STORAGE_ENVIRONMENT=local
ASKLAKE_STORAGE_DATA_RETENTION_DAYS=0
ASKLAKE_STORAGE_CHECKPOINT_RETENTION_DAYS=30
ASKLAKE_STORAGE_MANIFEST_RETENTION_DAYS=90
ASKLAKE_STORAGE_QUARANTINE_RETENTION_DAYS=30
ASKLAKE_STORAGE_LOG_RETENTION_DAYS=14
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=asklake-output
MINIO_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9000
S3_FORCE_PATH_STYLE=true
S3_ALLOWED_BUCKETS=asklake-output
ASKLAKE_SQL_PREVIEW_MAX_REMOTE_BYTES=536870912

# Airflow orchestration. Leave AIRFLOW_API_BASE_URL empty unless a local or
# external Airflow API is available.
AIRFLOW_API_BASE_URL=
AIRFLOW_DAG_ID=asklake_etl_job
AIRFLOW_UI_BASE_URL=
AIRFLOW_API_TOKEN=
AIRFLOW_USERNAME=
AIRFLOW_PASSWORD=
AIRFLOW_REQUEST_TIMEOUT_SECONDS=10
AIRFLOW_EXECUTION_API_TOKEN=asklake-local-airflow-execution
AIRFLOW_INTERNAL_TOKEN=asklake-local-airflow-token

# Trino/Iceberg Query Run runtime. Result pages are private S3-compatible
# objects; PostgreSQL stores only page metadata and the result manifest.
TRINO_ENABLED=false
TRINO_BASE_URL=http://localhost:8088
TRINO_CATALOG=iceberg
TRINO_SCHEMA=asklake
TRINO_USER=asklake-api
TRINO_QUERY_TIMEOUT_SECONDS=300
TRINO_MAX_RESPONSE_BYTES=2000000
TRINO_MAX_RESULT_BYTES=50000000
TRINO_MAX_RESULT_PAGES=1000
TRINO_RESULT_RETENTION_SECONDS=86400
TRINO_MAX_CONCURRENT_RUNS_PER_USER=2
TRINO_RESULT_STORAGE_BUCKET=asklake-query-results
TRINO_RESULT_STORAGE_PREFIX=query-results
TRINO_RESULT_STORAGE_AUTO_CREATE_BUCKET=true
TRINO_RESULT_STORAGE_ACCESS_KEY=asklake-query-results
TRINO_RESULT_STORAGE_SECRET_KEY=asklake-query-results-local-secret
TRINO_RESULT_CURSOR_SECRET=replace-with-a-long-random-local-secret
TRINO_QUERY_CONFIRMATION_SECRET=replace-with-a-long-random-local-secret
TRINO_QUERY_CONFIRMATION_TTL_SECONDS=300
TRINO_QUERY_WARNING_BYTES=1073741824
TRINO_QUERY_MAX_ESTIMATED_BYTES=0
TRINO_QUERY_ESTIMATED_THROUGHPUT_BYTES_PER_SECOND=268435456
TRINO_COLLECTOR_LEASE_SECONDS=60
TRINO_COLLECTOR_PAGES_PER_LEASE=100
TRINO_COLLECTOR_POLL_SECONDS=1
TRINO_CLEANUP_POLL_SECONDS=3600
TRINO_AUTH_USERNAME=
TRINO_AUTH_PASSWORD=
TRINO_MATERIALIZER_USERNAME=asklake-materializer
TRINO_MATERIALIZER_PASSWORD=
TRINO_TLS_CA_FILE=

# Kafka Runtime. Local development keeps Redpanda. Amazon MSK Serverless is an
# opt-in deployment runtime that uses IAM SASL/OAUTHBEARER + TLS and the AWS
# default credential chain; never add static Kafka/AWS credentials here.
ASKLAKE_KAFKA_RUNTIME=redpanda
ASKLAKE_KAFKA_ENVIRONMENT=local
ASKLAKE_KAFKA_BROKER=127.0.0.1:19092
ASKLAKE_KAFKA_CONNECT_TIMEOUT_MS=3000
ASKLAKE_KAFKA_REQUEST_TIMEOUT_MS=5000
ASKLAKE_KAFKA_RETRY_COUNT=2
ASKLAKE_KAFKA_SAMPLE_TIMEOUT_MS=8000
ASKLAKE_KAFKA_SAMPLE_IDLE_MS=500
ASKLAKE_KAFKA_SAMPLE_MIN_MESSAGES=3
ASKLAKE_KAFKA_SAMPLE_SETTLE_MS=1500
ASKLAKE_MSK_ENABLED=false
ASKLAKE_MSK_BOOTSTRAP_BROKERS=
ASKLAKE_MSK_REGION=
ASKLAKE_MSK_AUTH_MODE=iam
ASKLAKE_MSK_TLS_ENABLED=true
# Empty values use Runtime defaults. MSK defaults to asklake.<environment>,
# policy enforcement on, at least 3 partitions, and seven-day retention.
ASKLAKE_KAFKA_TOPIC_PREFIX=
ASKLAKE_KAFKA_TOPIC_POLICY_ENFORCED=
ASKLAKE_KAFKA_TOPIC_MIN_PARTITIONS=
ASKLAKE_KAFKA_TOPIC_RETENTION_MS=
ASKLAKE_MSK_PROBE_TOPIC=
ASKLAKE_MSK_PROBE_TIMEOUT_MS=15000

# Kafka Continuous control-plane synchronization and finite maintenance lease.
CONTINUOUS_RUNTIME_SYNC_INTERVAL_SECONDS=5
ASKLAKE_CONTINUOUS_MAINTENANCE_LEASE_SECONDS=900
# Test harness only: fail one worker attempt after durable data and before its manifest.
ASKLAKE_CONTINUOUS_FAIL_AFTER_DATA_WRITE_ONCE=false
