APP_NAME=AskLake FastAPI Backend
APP_ENV=local
API_PREFIX=/api
# local keeps the embedded development loop; deployed API uses `disabled` and
# a dedicated process uses `worker`.
ASKLAKE_CONTINUOUS_CONTROL_PLANE=embedded
STARTUP_SCHEMA_MANAGEMENT_ENABLED=true
ASKLAKE_CONTINUOUS_CONTROL_LEASE_SECONDS=30
# Optional shared runtime documents for an external Spark/Kubernetes worker.
# Leave empty for the local mounted report directory.
ASKLAKE_CONTINUOUS_RUNTIME_DOCUMENT_PREFIX=
# EKS-only Continuous SparkApplication mode. Local development continues to
# use ASKLAKE_SPARK_RUNNER=docker or rest instead.
ASKLAKE_CONTINUOUS_SPARK_RUNNER=
ASKLAKE_SPARK_KUBERNETES_NAMESPACE=
ASKLAKE_SPARK_KUBERNETES_IMAGE=
ASKLAKE_SPARK_KUBERNETES_SERVICE_ACCOUNT=
# Kubernetes SparkApplications reference these keys through a Secret instead
# of embedding JDBC values in the custom-resource specification.
ASKLAKE_SPARK_KUBERNETES_RUNTIME_SECRET_NAME=asklake-spark-runtime
ASKLAKE_SPARK_KUBERNETES_ICEBERG_JDBC_URL_KEY=ASKLAKE_SPARK_ICEBERG_JDBC_URL
ASKLAKE_SPARK_KUBERNETES_ICEBERG_JDBC_USER_KEY=ASKLAKE_SPARK_ICEBERG_JDBC_USER
ASKLAKE_SPARK_KUBERNETES_ICEBERG_JDBC_PASSWORD_KEY=ASKLAKE_SPARK_ICEBERG_JDBC_PASSWORD
# JSON objects/arrays matching the SparkApplication API; keep workload
# scheduling and IRSA/S3A configuration explicit in the deployment env.
ASKLAKE_SPARK_KUBERNETES_HADOOP_CONF=
ASKLAKE_SPARK_KUBERNETES_NODE_SELECTOR=
ASKLAKE_SPARK_KUBERNETES_TOLERATIONS=
DATABASE_URL=postgresql+psycopg://asklake:asklake_dev@localhost:54328/asklake
LOCAL_LAKE_STORAGE_DIR=
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=AskLake Administrator
# Legacy demo identities are test-only and rejected in local/development/production runtimes.
AUTH_LEGACY_DEMO_USERS_ENABLED=false
# Production defaults to administrator-provisioned accounts only.
AUTH_PUBLIC_SIGNUP_ENABLED=false
AI_ASSISTANT_ENABLED=true
AI_ASSISTANT_MAX_SAMPLE_ROWS=5
AI_QUERY_PROVIDER=gateway
AI_GATEWAY_BASE_URL=
AI_GATEWAY_GENERATE_PATH=/v1/generate
AI_GATEWAY_CLASSIFICATION_PATH=/v1/generate
AI_GATEWAY_EMBEDDINGS_PATH=/v1/embeddings
AI_GATEWAY_SERVICE_TOKEN=
AI_GATEWAY_TIMEOUT_SECONDS=30
AI_GATEWAY_MAX_RESPONSE_BYTES=1048576
AI_GATEWAY_MAX_EMBEDDING_RESPONSE_BYTES=8388608
AI_MCP_PATH=/internal/mcp
AI_MCP_SERVICE_TOKEN=
AI_CONTEXT_SIGNING_SECRET=asklake-local-ai-context-signing-secret
AI_CONTEXT_TTL_SECONDS=300
AI_CONTEXT_MAX_SAMPLE_ROWS=20

# Review analysis uses the same private AI Gateway as SQL, ETL, RAG, and dashboards.
ASKLAKE_REVIEW_ANALYSIS_RUNTIME=gateway
ASKLAKE_REVIEW_ANALYSIS_DEFAULT_LIMIT=25
ASKLAKE_REVIEW_AI_MAX_ROWS=100
ASKLAKE_REVIEW_AI_CONCURRENCY=4
ASKLAKE_REVIEW_AI_MAX_INPUT_CHARS=9000
ASKLAKE_REVIEW_TEXT_MODEL_HOST_DIR=
ASKLAKE_REVIEW_MODEL_MINIMUM_QUALITY=0.75
ASKLAKE_REVIEW_MODEL_MINIMUM_CLASS_ROWS=2
ASKLAKE_MODEL_TRAINING_TIMEOUT_SECONDS=900
ASKLAKE_REVIEW_RUN_STALE_SECONDS=3600

# Spark-backed Parquet schema/sample inspection. Cold local Spark startup can
# take longer than 30 seconds even for a small bounded preview.
ASKLAKE_SOURCE_INSPECT_TIMEOUT_MS=90000

# Row-oriented File/S3 Prefix previews validate the representative object
# first, then validate remaining objects with bounded parallel range reads.
# Each object starts at 64 KiB and expands only when a complete sample is
# insufficient. Concurrency is clamped to 1..32.
ASKLAKE_PREFIX_VALIDATION_CONCURRENCY=8
ASKLAKE_PREFIX_INITIAL_SAMPLE_BYTES=65536

# SQL Preview reads Catalog s3:// or s3a:// Parquet through the server-side
# S3 client, caches it only for the lifetime of one query, and refuses a query
# before download when the combined object size exceeds this byte limit.
ASKLAKE_OBJECT_STORAGE_PROVIDER=minio
SCHEDULED_JOB_TICK_INTERVAL_SECONDS=30
CATALOG_DELETION_WORKER_ENABLED=true
CATALOG_DELETION_WORKER_INTERVAL_SECONDS=2
ASKLAKE_RAW_BUCKET=m3-raw
# Optional non-secret values shown only when a new Source draft is empty.
# An empty bucket falls back to ASKLAKE_RAW_BUCKET.
ASKLAKE_SOURCE_DEFAULT_S3_BUCKET=
ASKLAKE_SOURCE_DEFAULT_S3_PREFIX=
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=asklake-output
MINIO_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9000
S3_FORCE_PATH_STYLE=true
S3_ALLOWED_BUCKETS=asklake-output
ASKLAKE_SQL_PREVIEW_MAX_REMOTE_BYTES=536870912

# Airflow orchestration. Leave AIRFLOW_API_BASE_URL empty unless a local or
# external Airflow API is available.
AIRFLOW_API_BASE_URL=
AIRFLOW_DAG_ID=asklake_etl_job
RAG_AIRFLOW_DAG_ID=asklake_rag_index
AIRFLOW_UI_BASE_URL=
AIRFLOW_API_TOKEN=
AIRFLOW_USERNAME=
AIRFLOW_PASSWORD=
AIRFLOW_REQUEST_TIMEOUT_SECONDS=10
AIRFLOW_RUN_SYNC_INTERVAL_SECONDS=5
RAG_WORKER_BASE_URL=http://localhost:8090
RAG_WORKER_TOKEN=asklake-local-rag-worker-token
AIRFLOW_EXECUTION_API_TOKEN=asklake-local-airflow-execution
AIRFLOW_INTERNAL_TOKEN=asklake-local-airflow-token

RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536
RAG_EMBEDDING_BATCH_SIZE=64
RAG_CHUNK_TARGET_TOKENS=800
RAG_CHUNK_OVERLAP_TOKENS=400
RAG_CHUNK_MAX_TOKENS=1200
RAG_STAGING_BASE_PATH=s3a://asklake-warehouse/rag-staging
RAG_PARENT_ICEBERG_NAMESPACE=rag
OPENSEARCH_BASE_URL=http://localhost:9200
OPENSEARCH_VERIFY_TLS=false

# Trino/Iceberg Query Run runtime. Result pages are private S3-compatible
# objects; PostgreSQL stores only page metadata and the result manifest.
TRINO_ENABLED=false
TRINO_BASE_URL=http://localhost:8088
TRINO_CATALOG=iceberg
TRINO_SCHEMA=asklake
# Optional comma-separated allowlist. When omitted, TRINO_SCHEMA is the only target shown.
ASKLAKE_TARGET_DATABASES=asklake
TRINO_USER=asklake-api
TRINO_QUERY_TIMEOUT_SECONDS=300
TRINO_MAX_RESPONSE_BYTES=2000000
TRINO_MAX_RESULT_BYTES=50000000
TRINO_MAX_RESULT_PAGES=1000
TRINO_RESULT_RETENTION_SECONDS=86400
TRINO_MAX_CONCURRENT_RUNS_PER_USER=2
TRINO_RESULT_STORAGE_BUCKET=asklake-query-results
TRINO_RESULT_STORAGE_PREFIX=query-results
TRINO_RESULT_STORAGE_AUTO_CREATE_BUCKET=true
TRINO_RESULT_STORAGE_ACCESS_KEY=asklake-query-results
TRINO_RESULT_STORAGE_SECRET_KEY=asklake-query-results-local-secret
TRINO_RESULT_CURSOR_SECRET=replace-with-a-long-random-local-secret
TRINO_QUERY_CONFIRMATION_SECRET=replace-with-a-long-random-local-secret
TRINO_QUERY_CONFIRMATION_TTL_SECONDS=300
TRINO_QUERY_WARNING_BYTES=1073741824
TRINO_QUERY_MAX_ESTIMATED_BYTES=0
TRINO_QUERY_ESTIMATED_THROUGHPUT_BYTES_PER_SECOND=268435456
TRINO_COLLECTOR_LEASE_SECONDS=60
TRINO_COLLECTOR_PAGES_PER_LEASE=100
TRINO_COLLECTOR_POLL_SECONDS=1
TRINO_CLEANUP_POLL_SECONDS=3600
TRINO_AUTH_USERNAME=
TRINO_AUTH_PASSWORD=
TRINO_MATERIALIZER_USERNAME=asklake-materializer
TRINO_MATERIALIZER_PASSWORD=
TRINO_TLS_CA_FILE=

# Kafka Continuous control-plane synchronization and finite maintenance lease.
ASKLAKE_KAFKA_BROKER=127.0.0.1:19092
# Host FastAPI keeps the loopback broker above. A Docker Spark worker uses this
# address only when the saved broker is localhost/127.0.0.1.
ASKLAKE_KAFKA_BROKER_IN_DOCKER=asklake-redpanda:9092
ASKLAKE_SOURCE_DEFAULT_KAFKA_TOPIC=asklake-source-events
ASKLAKE_KAFKA_SAMPLE_TIMEOUT_MS=8000
ASKLAKE_KAFKA_SAMPLE_IDLE_MS=500
ASKLAKE_KAFKA_SAMPLE_MIN_MESSAGES=3
ASKLAKE_KAFKA_SAMPLE_SETTLE_MS=1500
CONTINUOUS_RUNTIME_SYNC_INTERVAL_SECONDS=1
DASHBOARD_SYNC_MODE=polling
DASHBOARD_AUTO_REFRESH_ENABLED=false
REALTIME_EVENTS_ENABLED=false
CONTINUOUS_SQL_JOIN_ENABLED=false
CONTINUOUS_SQL_SERVING_MODE=iceberg
LATEST_STATIC_PER_BATCH_ENABLED=false
STATIC_CHANGE_BACKFILL_ENABLED=false
# Broadcast is used only when Catalog row statistics are present and bounded.
CONTINUOUS_SQL_STATIC_BROADCAST_MAX_ROWS=100000
# Reuse immutable static snapshots in Spark memory/disk below this Catalog row estimate.
CONTINUOUS_SQL_STATIC_CACHE_MAX_ROWS=5000000
CONTINUOUS_SQL_MICRO_BATCH_MAX_ROWS=100
CONTINUOUS_SQL_STATIC_PRUNING_MAX_KEYS=100
# Hard stop for unexpected stream-static JOIN row amplification per micro-batch.
CONTINUOUS_SQL_MAX_OUTPUT_ROWS_PER_INPUT=10
# Existing Kafka Engine/ClickHouse V1 compatibility flag. Keep false while the
# Kafka Connect V2 consumer owns a generation.
CLICKHOUSE_CONTINUOUS_JOIN_ENABLED=false
# ClickHouse Realtime V2 is opt-in. Starting the Compose profile alone does not
# transfer consumer ownership; all three values below must be changed together.
CLICKHOUSE_REALTIME_V2_ENABLED=false
KAFKA_CONNECT_SINK_ENABLED=false
CLICKHOUSE_REALTIME_CONSUMER_OWNER=disabled
KAFKA_CONNECT_URL=
KAFKA_CONNECT_CONNECTOR_NAME=asklake-clickhouse-realtime-v2
# Local side-by-side infrastructure defaults. Docker Compose reads these only
# when they are exported or copied to a root .env file.
CLICKHOUSE_V2_IMAGE=clickhouse/clickhouse-server:26.3.17.4@sha256:85c434814ac8905e5648027ce926f74ab067edd6aadbccb6c0c165cd3571ea49
CLICKHOUSE_V2_DATABASE=asklake_realtime_v2
CLICKHOUSE_V2_ADMIN_USER=asklake_v2_admin
CLICKHOUSE_V2_ADMIN_PASSWORD=replace-with-local-clickhouse-v2-admin-password
CLICKHOUSE_V2_INGEST_PASSWORD=replace-with-local-clickhouse-v2-ingest-password
CLICKHOUSE_V2_MATERIALIZER_PASSWORD=replace-with-local-clickhouse-v2-materializer-password
CLICKHOUSE_V2_READER_PASSWORD=replace-with-local-clickhouse-v2-reader-password
CLICKHOUSE_V2_MIGRATION_PASSWORD=replace-with-local-clickhouse-v2-migration-password
CLICKHOUSE_V2_OBSERVER_PASSWORD=replace-with-local-clickhouse-v2-observer-password
CLICKHOUSE_V2_HTTP_PORT=18123
KAFKA_CONNECT_V2_IMAGE=asklake/kafka-connect-clickhouse:1.4.0
KAFKA_CONNECT_V2_PORT=18083
KAFKA_CONNECT_V2_SECRETS_FILE=./deploy/kafka-connect/secrets.example.properties
REALTIME_EVENT_RETENTION_SECONDS=86400
REALTIME_EVENT_PAYLOAD_MAX_BYTES=8192
REALTIME_REPLAY_LIMIT=500
REALTIME_SUBSCRIBER_QUEUE_SIZE=128
REALTIME_CONNECTION_LIMIT_PER_ACTOR=5
REALTIME_HEARTBEAT_SECONDS=15
REALTIME_DISPATCH_POLL_SECONDS=0.5
REALTIME_CLEANUP_INTERVAL_SECONDS=3600
REALTIME_SSE_SEND_TIMEOUT_SECONDS=10
ASKLAKE_CONTINUOUS_MAINTENANCE_LEASE_SECONDS=900
ASKLAKE_CONTINUOUS_SPARK_SHUFFLE_PARTITIONS=4
ASKLAKE_CONTINUOUS_SPARK_LOG_LEVEL=WARN
# Test harness only: fail one worker attempt after durable data and before its manifest.
ASKLAKE_CONTINUOUS_FAIL_AFTER_DATA_WRITE_ONCE=false
