APP_NAME=AskLake FastAPI Backend
APP_ENV=local
API_PREFIX=/api
DATABASE_URL=postgresql+psycopg://asklake:asklake_dev@localhost:54328/asklake
LOCAL_LAKE_STORAGE_DIR=
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OPENAI_API_KEY=
OPENAI_ASSISTANT_ENABLED=true
OPENAI_ASSISTANT_MODEL=gpt-4o-mini
OPENAI_ASSISTANT_MAX_OUTPUT_TOKENS=1200
OPENAI_ASSISTANT_MAX_SAMPLE_ROWS=5
OPENAI_ASSISTANT_TIMEOUT_SECONDS=20
OPENAI_QUERY_AI_MODEL=gpt-4.1-mini

# Spark-backed Parquet schema/sample inspection. Cold local Spark startup can
# take longer than 30 seconds even for a small bounded preview.
ASKLAKE_SOURCE_INSPECT_TIMEOUT_MS=90000

# Airflow orchestration. Leave AIRFLOW_API_BASE_URL empty unless a local or
# external Airflow API is available.
AIRFLOW_API_BASE_URL=
AIRFLOW_DAG_ID=asklake_etl_job
AIRFLOW_UI_BASE_URL=
AIRFLOW_API_TOKEN=
AIRFLOW_USERNAME=
AIRFLOW_PASSWORD=
AIRFLOW_REQUEST_TIMEOUT_SECONDS=10
AIRFLOW_EXECUTION_API_TOKEN=asklake-local-airflow-execution
AIRFLOW_INTERNAL_TOKEN=asklake-local-airflow-token

# `auto` follows an s3a:// Job storagePath; deployment uses `s3a` explicitly.
ASKLAKE_SPARK_OUTPUT_MODE=auto
ASKLAKE_SPARK_RUN_TIMEOUT_SECONDS=7200
