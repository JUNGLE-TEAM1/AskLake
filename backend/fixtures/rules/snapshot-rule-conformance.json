      "records": [{ "event_id": "transform-fail-1", "rating": "bad" }],
      "rules": [
        {
          "contractVersion": "1.0", "enabled": true, "failureDisposition": "keep", "id": "rating-cast-required",
          "inputColumns": ["rating"], "kind": "transform", "onError": "fail_batch", "operation": "cast",
