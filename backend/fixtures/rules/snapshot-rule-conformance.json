          "configuredRuleCount": 2, "invalidRowCount": 2, "passRate": 0,
          "setNullCount": 1, "status": "warn", "warnCount": 1
        }
      }
    },
    {
      "name": "nested json extraction",
      "records": [
        { "event_id": "json-1", "payload": { "code": "N1" } }
