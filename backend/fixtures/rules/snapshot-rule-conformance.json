          "appliedStepCount": 1, "configuredStepCount": 1, "errorCount": 1, "quarantinedCount": 1
        },
        "quality": { "configuredRuleCount": 0, "invalidRowCount": 0, "status": "pass" }
      }
    },
    {
      "name": "quality drop rows",
      "records": [
        { "event_id": "drop-1", "score": "8", "status": "active" },
        { "event_id": "drop-2", "score": "5", "status": "" },
        { "event_id": "drop-3", "score": "20", "status": "active" }
      ],
      "rules": [
        {
          "contractVersion": "1.0", "enabled": true, "failureDisposition": "drop_row", "id": "status-required",
          "inputColumns": ["status"], "kind": "quality", "onError": "warn", "operation": "not_null",
          "outputColumns": [], "parameters": {}, "severity": "warning"
        },
        {
          "contractVersion": "1.0", "enabled": true, "failureDisposition": "drop_row", "id": "score-range",
          "inputColumns": ["score"], "kind": "quality", "onError": "warn", "operation": "range",
          "outputColumns": [], "parameters": { "inclusive": true, "max": 10, "min": 0 }, "severity": "warning"
        }
      ],
      "expected": {
        "status": "success",
        "records": [{ "event_id": "drop-1", "score": "8", "status": "active" }],
        "quarantine": [],
        "quality": {
          "configuredRuleCount": 2, "droppedCount": 2, "invalidRowCount": 2, "passRate": 33.3, "status": "warn"
