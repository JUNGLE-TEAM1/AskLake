{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["global", "namespace", "observabilityRbac", "serviceAccounts"],
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "clusterName", "kafkaRuntime", "kafkaAuth", "trinoRuntime", "continuousOwner", "workloadIdentityMode"],
      "properties": {
        "environment": { "type": "string", "enum": ["dev", "staging"] },
        "clusterName": { "type": "string" },
        "kafkaRuntime": { "type": "string", "const": "msk-serverless" },
        "kafkaAuth": { "type": "string", "const": "iam" },
        "trinoRuntime": { "type": "string", "const": "eks" },
        "continuousOwner": { "type": "string", "const": "ec2-mvp" },
        "workloadIdentityMode": { "type": "string", "enum": ["disabled", "irsa", "pod_identity"] }
      }
    },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "labels"],
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "observabilityRbac": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "kubernetesGroup"],
      "properties": {
        "enabled": { "type": "boolean" },
        "kubernetesGroup": {
          "type": "string",
          "const": "asklake:observability-readers"
        }
      }
    },
    "serviceAccounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frontend", "backend", "aiGateway", "airflow", "trino", "mskSmoke", "spark", "replayProducer"],
      "properties": {
        "frontend": { "$ref": "#/$defs/nonKubernetesApiServiceAccount" },
        "backend": { "$ref": "#/$defs/kubernetesApiServiceAccount" },
        "aiGateway": { "$ref": "#/$defs/nonKubernetesApiServiceAccount" },
        "airflow": { "$ref": "#/$defs/nonKubernetesApiServiceAccount" },
        "trino": { "$ref": "#/$defs/nonKubernetesApiServiceAccount" },
        "mskSmoke": { "$ref": "#/$defs/nonKubernetesApiServiceAccount" },
        "spark": { "$ref": "#/$defs/kubernetesApiServiceAccount" },
        "replayProducer": { "$ref": "#/$defs/disabledServiceAccount" }
      }
    }
  },
  "$defs": {
    "kubernetesApiServiceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "annotations", "automountServiceAccountToken"],
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "automountServiceAccountToken": { "type": "boolean", "const": true }
      }
    },
    "nonKubernetesApiServiceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "annotations", "automountServiceAccountToken"],
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "automountServiceAccountToken": { "type": "boolean", "const": false }
      }
    },
    "disabledServiceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "annotations", "automountServiceAccountToken"],
      "properties": {
        "create": { "type": "boolean", "const": false },
        "name": { "type": "string", "const": "asklake-replay-producer" },
        "annotations": { "type": "object", "maxProperties": 0 },
        "automountServiceAccountToken": { "type": "boolean", "const": false }
      }
    }
  }
}
