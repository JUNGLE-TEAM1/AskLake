{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["global", "namespace", "serviceAccounts"],
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "clusterName", "kafkaRuntime", "kafkaAuth", "continuousOwner"],
      "properties": {
        "environment": { "type": "string", "enum": ["dev", "staging"] },
        "clusterName": { "type": "string" },
        "kafkaRuntime": { "type": "string", "const": "msk-serverless" },
        "kafkaAuth": { "type": "string", "const": "iam" },
        "continuousOwner": { "type": "string", "const": "ec2-mvp" }
      }
    },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "labels"],
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "serviceAccounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frontend", "backend", "airflow", "spark"],
      "properties": {
        "frontend": { "$ref": "#/$defs/serviceAccount" },
        "backend": { "$ref": "#/$defs/serviceAccount" },
        "airflow": { "$ref": "#/$defs/serviceAccount" },
        "spark": { "$ref": "#/$defs/serviceAccount" }
      }
    }
  },
  "$defs": {
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "annotations", "automountServiceAccountToken"],
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    }
  }
}
