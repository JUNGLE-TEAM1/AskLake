aws_region  = "ap-northeast-2"
environment = "dev"
name_prefix = "asklake"
owner              = "REPLACE_WITH_TEAM_OWNER"
resource_lifecycle = "mvp-owned"

# Choose only after read-only inventory and ownership review.
cluster_mode          = "existing"
existing_cluster_name = "REPLACE_WITH_EXISTING_CLUSTER"

# For cluster_mode = "create", remove existing_cluster_name and provide reviewed
# subnets in at least two Availability Zones. This example intentionally does
# not contain real subnet IDs.
control_plane_subnet_ids = []
node_subnet_ids          = []

endpoint_private_access = true
endpoint_public_access  = false
public_access_cidrs     = []

# Enable only after node subnet, instance type, quota and cost review.
create_managed_node_group = false
node_instance_types       = []
node_capacity_type        = "ON_DEMAND"
node_min_size             = 1
node_desired_size         = 1
node_max_size             = 3

# These repositories are MVP-owned. Set false when an external platform team
# provides repositories and pass their URLs through the deployment environment.
create_ecr_repositories = true

# Keep null until the team approves image retention and deletion behavior.
ecr_untagged_retention_days = null

namespace = "asklake-dev"

# Trino contract references are safe to keep in tfvars, but actual ARN/digest
# values remain null until image delivery and workload identity are approved.
trino_image_digest                  = null
trino_irsa_role_arn                 = null
trino_service_name                  = "asklake-trino"
trino_service_port                  = 8443
trino_tls_auth_secret_name          = "asklake-trino-tls-auth"
trino_jdbc_secret_name              = "asklake-trino-iceberg-jdbc"
trino_iceberg_catalog_database      = "iceberg_catalog"
trino_rds_endpoint_reference        = "TRINO_ICEBERG_JDBC_URL"
trino_rds_security_group_reference  = null
trino_warehouse_bucket_reference    = "TRINO_ICEBERG_WAREHOUSE_BUCKET"
trino_warehouse_prefix_reference    = "TRINO_ICEBERG_WAREHOUSE_PREFIX"

# Phase 3 data plane is opt-in. Keep every mode disabled until Phase 2
# inventory, ownership, private network, cost and destroy gates are approved.
msk_mode     = "disabled"
rds_mode     = "disabled"
storage_mode = "disabled"

# For msk_mode = "create", provide at least two reviewed private subnet IDs
# and an explicit client security group. Topic creation is an operational
# bootstrap step; Terraform only fixes the isolated topic/group contract.
msk_subnet_ids          = []
msk_security_group_ids  = []
msk_test_topic          = "asklake.eks-mvp.fixture.v1"
msk_test_consumer_group = "asklake-eks-mvp-spark-v1"

# For rds_mode = "create", select the instance class and optional engine
# version only after workload/cost review. Terraform creates asklake_app;
# airflow_metadata and iceberg_catalog are created by a later DB bootstrap.
rds_subnet_ids         = []
rds_security_group_ids = []
rds_instance_class     = null
rds_engine_version     = null
rds_multi_az           = false

# For storage_mode = "existing" or "create", replace every empty value with
# deployment-owned names. AES256 is the no-extra-key baseline. Switching to
# aws:kms requires a reviewed key ARN and workload KMS permissions.
storage_bucket_names = {
  raw           = ""
  output        = ""
  warehouse     = ""
  query_results = ""
}
storage_sse_algorithm = "AES256"
storage_kms_key_arn   = null

# Phase 4 workload identity is another explicit selection gate. Leave disabled
# until the team studies IRSA vs EKS Pod Identity in the actual cluster.
workload_identity_mode = "disabled"

# IRSA reuses an already reviewed IAM OIDC provider. This application state
# does not create or assume ownership of a shared provider.
irsa_oidc_provider_arn = null

# Pod Identity can be selected only after the platform owner confirms that the
# EKS Pod Identity Agent is installed and managed.
pod_identity_agent_ready = false
