{
  "contractVersion": "1.0",
  "namespace": "asklake-dev",
  "delivery": {
    "mode": "disabled",
    "controllerReady": false,
    "controllerOwner": null,
    "rotationOwner": null,
    "sourcePrefix": null
  },
  "secrets": {
    "backend": {
      "name": "asklake-backend-runtime",
      "consumers": ["backend"],
      "keys": [
        "DATABASE_URL",
        "BOOTSTRAP_ADMIN_PASSWORD",
        "AI_GATEWAY_SERVICE_TOKEN",
        "AI_MCP_SERVICE_TOKEN",
        "AI_CONTEXT_SIGNING_SECRET",
        "OPENAI_API_KEY",
        "AIRFLOW_API_TOKEN",
        "AIRFLOW_PASSWORD",
        "AIRFLOW_EXECUTION_API_TOKEN",
        "AIRFLOW_INTERNAL_TOKEN",
        "TRINO_AUTH_USERNAME",
        "TRINO_AUTH_PASSWORD",
        "TRINO_MATERIALIZER_USERNAME",
        "TRINO_MATERIALIZER_PASSWORD",
        "TRINO_RESULT_CURSOR_SECRET",
        "TRINO_QUERY_CONFIRMATION_SECRET",
        "trino-ca.pem"
      ]
    },
    "airflow": {
      "name": "asklake-airflow-runtime",
      "consumers": ["airflow-api-server", "airflow-scheduler", "airflow-dag-processor", "airflow-db-migration"],
      "keys": [
        "AIRFLOW__DATABASE__SQL_ALCHEMY_CONN",
        "AIRFLOW_PASSWORD",
        "AIRFLOW_EXECUTION_API_TOKEN",
        "AIRFLOW_INTERNAL_TOKEN",
        "AIRFLOW__CORE__FERNET_KEY",
        "AIRFLOW__API_AUTH__JWT_SECRET"
      ]
    },
    "spark": {
      "name": "asklake-spark-runtime",
      "consumers": ["spark-driver", "spark-executor"],
      "keys": [
        "ASKLAKE_SPARK_ICEBERG_JDBC_URL",
        "ASKLAKE_SPARK_ICEBERG_JDBC_USER",
        "ASKLAKE_SPARK_ICEBERG_JDBC_PASSWORD"
      ]
    },
    "trino": {
      "name": "asklake-trino-runtime",
      "consumers": ["trino-coordinator"],
      "keys": [
        "TRINO_ICEBERG_JDBC_URL",
        "TRINO_ICEBERG_JDBC_USER",
        "TRINO_ICEBERG_JDBC_PASSWORD",
        "TRINO_TLS_KEYSTORE_PASSWORD",
        "TRINO_INTERNAL_SHARED_SECRET",
        "trino-keystore.jks",
        "trino-password.db"
      ]
    }
  },
  "sharedBindings": [
    {
      "logicalName": "airflow-api-password",
      "bindings": [
        "backend:AIRFLOW_PASSWORD",
        "airflow:AIRFLOW_PASSWORD"
      ]
    },
    {
      "logicalName": "airflow-execution-api-token",
      "bindings": [
        "backend:AIRFLOW_EXECUTION_API_TOKEN",
        "airflow:AIRFLOW_EXECUTION_API_TOKEN"
      ]
    },
    {
      "logicalName": "airflow-internal-token",
      "bindings": [
        "backend:AIRFLOW_INTERNAL_TOKEN",
        "airflow:AIRFLOW_INTERNAL_TOKEN"
      ]
    },
    {
      "logicalName": "iceberg-jdbc-url",
      "bindings": [
        "spark:ASKLAKE_SPARK_ICEBERG_JDBC_URL",
        "trino:TRINO_ICEBERG_JDBC_URL"
      ]
    },
    {
      "logicalName": "iceberg-jdbc-user",
      "bindings": [
        "spark:ASKLAKE_SPARK_ICEBERG_JDBC_USER",
        "trino:TRINO_ICEBERG_JDBC_USER"
      ]
    },
    {
      "logicalName": "iceberg-jdbc-password",
      "bindings": [
        "spark:ASKLAKE_SPARK_ICEBERG_JDBC_PASSWORD",
        "trino:TRINO_ICEBERG_JDBC_PASSWORD"
      ]
    }
  ],
  "envBindings": [
    {
      "binding": "backend:DATABASE_URL",
      "consumers": ["backend"],
      "env": "DATABASE_URL"
    },
    {
      "binding": "backend:BOOTSTRAP_ADMIN_PASSWORD",
      "consumers": ["backend"],
      "env": "BOOTSTRAP_ADMIN_PASSWORD"
    },
    {
      "binding": "backend:AI_GATEWAY_SERVICE_TOKEN",
      "consumers": ["backend"],
      "env": "AI_GATEWAY_SERVICE_TOKEN"
    },
    {
      "binding": "backend:AI_MCP_SERVICE_TOKEN",
      "consumers": ["backend"],
      "env": "AI_MCP_SERVICE_TOKEN"
    },
    {
      "binding": "backend:AI_CONTEXT_SIGNING_SECRET",
      "consumers": ["backend"],
      "env": "AI_CONTEXT_SIGNING_SECRET"
    },
    {
      "binding": "backend:OPENAI_API_KEY",
      "consumers": ["backend"],
      "env": "OPENAI_API_KEY"
    },
    {
      "binding": "backend:AIRFLOW_API_TOKEN",
      "consumers": ["backend"],
      "env": "AIRFLOW_API_TOKEN"
    },
    {
      "binding": "backend:AIRFLOW_PASSWORD",
      "consumers": ["backend"],
      "env": "AIRFLOW_PASSWORD"
    },
    {
      "binding": "backend:AIRFLOW_EXECUTION_API_TOKEN",
      "consumers": ["backend"],
      "env": "AIRFLOW_EXECUTION_API_TOKEN"
    },
    {
      "binding": "backend:AIRFLOW_INTERNAL_TOKEN",
      "consumers": ["backend"],
      "env": "AIRFLOW_INTERNAL_TOKEN"
    },
    {
      "binding": "backend:TRINO_AUTH_USERNAME",
      "consumers": ["backend"],
      "env": "TRINO_AUTH_USERNAME"
    },
    {
      "binding": "backend:TRINO_AUTH_PASSWORD",
      "consumers": ["backend"],
      "env": "TRINO_AUTH_PASSWORD"
    },
    {
      "binding": "backend:TRINO_MATERIALIZER_USERNAME",
      "consumers": ["backend"],
      "env": "TRINO_MATERIALIZER_USERNAME"
    },
    {
      "binding": "backend:TRINO_MATERIALIZER_PASSWORD",
      "consumers": ["backend"],
      "env": "TRINO_MATERIALIZER_PASSWORD"
    },
    {
      "binding": "backend:TRINO_RESULT_CURSOR_SECRET",
      "consumers": ["backend"],
      "env": "TRINO_RESULT_CURSOR_SECRET"
    },
    {
      "binding": "backend:TRINO_QUERY_CONFIRMATION_SECRET",
      "consumers": ["backend"],
      "env": "TRINO_QUERY_CONFIRMATION_SECRET"
    },
    {
      "binding": "airflow:AIRFLOW__DATABASE__SQL_ALCHEMY_CONN",
      "consumers": ["airflow-api-server", "airflow-scheduler", "airflow-dag-processor", "airflow-db-migration"],
      "env": "AIRFLOW__DATABASE__SQL_ALCHEMY_CONN"
    },
    {
      "binding": "airflow:AIRFLOW_PASSWORD",
      "consumers": ["airflow-db-migration"],
      "env": "AIRFLOW_API_PASSWORD"
    },
    {
      "binding": "airflow:AIRFLOW_EXECUTION_API_TOKEN",
      "consumers": ["airflow-api-server", "airflow-scheduler", "airflow-dag-processor"],
      "env": "ASKLAKE_EXECUTION_API_TOKEN"
    },
    {
      "binding": "airflow:AIRFLOW_INTERNAL_TOKEN",
      "consumers": ["airflow-api-server", "airflow-scheduler", "airflow-dag-processor"],
      "env": "AIRFLOW_INTERNAL_TOKEN"
    },
    {
      "binding": "airflow:AIRFLOW__CORE__FERNET_KEY",
      "consumers": ["airflow-api-server", "airflow-scheduler", "airflow-dag-processor", "airflow-db-migration"],
      "env": "AIRFLOW__CORE__FERNET_KEY"
    },
    {
      "binding": "airflow:AIRFLOW__API_AUTH__JWT_SECRET",
      "consumers": ["airflow-api-server", "airflow-scheduler", "airflow-dag-processor", "airflow-db-migration"],
      "env": "AIRFLOW__API_AUTH__JWT_SECRET"
    },
    {
      "binding": "spark:ASKLAKE_SPARK_ICEBERG_JDBC_URL",
      "consumers": ["spark-driver", "spark-executor"],
      "env": "ASKLAKE_SPARK_ICEBERG_JDBC_URL"
    },
    {
      "binding": "spark:ASKLAKE_SPARK_ICEBERG_JDBC_USER",
      "consumers": ["spark-driver", "spark-executor"],
      "env": "ASKLAKE_SPARK_ICEBERG_JDBC_USER"
    },
    {
      "binding": "spark:ASKLAKE_SPARK_ICEBERG_JDBC_PASSWORD",
      "consumers": ["spark-driver", "spark-executor"],
      "env": "ASKLAKE_SPARK_ICEBERG_JDBC_PASSWORD"
    },
    {
      "binding": "trino:TRINO_ICEBERG_JDBC_URL",
      "consumers": ["trino-coordinator"],
      "env": "TRINO_ICEBERG_JDBC_URL"
    },
    {
      "binding": "trino:TRINO_ICEBERG_JDBC_USER",
      "consumers": ["trino-coordinator"],
      "env": "TRINO_ICEBERG_JDBC_USER"
    },
    {
      "binding": "trino:TRINO_ICEBERG_JDBC_PASSWORD",
      "consumers": ["trino-coordinator"],
      "env": "TRINO_ICEBERG_JDBC_PASSWORD"
    },
    {
      "binding": "trino:TRINO_TLS_KEYSTORE_PASSWORD",
      "consumers": ["trino-coordinator"],
      "env": "TRINO_TLS_KEYSTORE_PASSWORD"
    },
    {
      "binding": "trino:TRINO_INTERNAL_SHARED_SECRET",
      "consumers": ["trino-coordinator"],
      "env": "TRINO_INTERNAL_SHARED_SECRET"
    }
  ],
  "fileMounts": [
    {
      "binding": "backend:trino-ca.pem",
      "mountPath": "/var/run/asklake/secrets/trino-ca.pem",
      "readOnly": true
    },
    {
      "binding": "trino:trino-keystore.jks",
      "mountPath": "/etc/trino/tls/keystore.jks",
      "readOnly": true
    },
    {
      "binding": "trino:trino-password.db",
      "mountPath": "/etc/trino/auth/password.db",
      "readOnly": true
    }
  ],
  "runtimeProfiles": {
    "backend": {
      "active": "bounded",
      "boundedKeys": [
        "DATABASE_URL",
        "BOOTSTRAP_ADMIN_PASSWORD",
        "AIRFLOW_PASSWORD",
        "AIRFLOW_EXECUTION_API_TOKEN",
        "AIRFLOW_INTERNAL_TOKEN",
        "TRINO_AUTH_USERNAME",
        "TRINO_AUTH_PASSWORD",
        "TRINO_MATERIALIZER_USERNAME",
        "TRINO_MATERIALIZER_PASSWORD",
        "TRINO_RESULT_CURSOR_SECRET",
        "TRINO_QUERY_CONFIRMATION_SECRET",
        "trino-ca.pem"
      ],
      "fullServiceKeys": {
        "common": [
          "DATABASE_URL",
          "BOOTSTRAP_ADMIN_PASSWORD",
          "AIRFLOW_EXECUTION_API_TOKEN",
          "AIRFLOW_INTERNAL_TOKEN",
          "TRINO_AUTH_USERNAME",
          "TRINO_AUTH_PASSWORD",
          "TRINO_MATERIALIZER_USERNAME",
          "TRINO_MATERIALIZER_PASSWORD",
          "TRINO_RESULT_CURSOR_SECRET",
          "TRINO_QUERY_CONFIRMATION_SECRET",
          "trino-ca.pem"
        ],
        "airflowApiAuth": {
          "api_token": ["AIRFLOW_API_TOKEN"],
          "username_password": ["AIRFLOW_PASSWORD"]
        },
        "aiRuntime": {
          "direct": ["OPENAI_API_KEY"],
          "gateway": [
            "AI_GATEWAY_SERVICE_TOKEN",
            "AI_MCP_SERVICE_TOKEN",
            "AI_CONTEXT_SIGNING_SECRET",
            "OPENAI_API_KEY"
          ]
        }
      }
    }
  },
  "forbiddenKeys": [
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_SESSION_TOKEN",
    "MINIO_ACCESS_KEY",
    "MINIO_SECRET_KEY"
  ],
  "runtimeDecisions": {
    "airflowApiAuth": {
      "status": "selected",
      "selected": "username_password",
      "allowed": ["api_token", "username_password"]
    },
    "aiRuntime": {
      "status": "learning-required",
      "selected": null,
      "allowed": ["gateway", "direct"]
    },
    "aiProviderWorkload": {
      "status": "learning-required",
      "selected": null,
      "allowed": ["contract-approved"]
    }
  }
}
