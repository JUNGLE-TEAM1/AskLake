{
  "contractVersion": "1.0",
  "namespace": "asklake-dev",
  "delivery": {
    "mode": "disabled",
    "secretStore": "asklake-secrets-manager",
    "rotationOwner": null
  },
  "secrets": {
    "keeperConfig": {
      "name": "asklake-clickhouse-keeper-v2-config",
      "consumers": ["clickhouse-keeper-v2"],
      "keys": ["keeper.xml"]
    },
    "clickhouseConfig": {
      "name": "asklake-clickhouse-v2-config",
      "consumers": ["clickhouse-v2"],
      "keys": [
        "tls.xml",
        "keeper.xml",
        "ca.crt",
        "server.crt",
        "server.key",
        "adminPassword",
        "ingestPassword",
        "materializerPassword",
        "migrationPassword",
        "observerPassword",
        "readerPassword"
      ]
    },
    "kafkaConnect": {
      "name": "asklake-kafka-connect-v2-runtime",
      "consumers": ["kafka-connect-v2"],
      "requiredEnvKeys": [
        "CONNECT_BOOTSTRAP_SERVERS",
        "CONNECT_GROUP_ID",
        "CONNECT_CONFIG_STORAGE_TOPIC",
        "CONNECT_OFFSET_STORAGE_TOPIC",
        "CONNECT_STATUS_STORAGE_TOPIC",
        "CONNECT_CONFIG_STORAGE_REPLICATION_FACTOR",
        "CONNECT_OFFSET_STORAGE_REPLICATION_FACTOR",
        "CONNECT_STATUS_STORAGE_REPLICATION_FACTOR",
        "CONNECT_CONFIG_PROVIDERS",
        "CONNECT_CONFIG_PROVIDERS_FILE_CLASS",
        "CONNECT_CONNECTOR_CLIENT_CONFIG_OVERRIDE_POLICY",
        "CONNECT_KEY_CONVERTER",
        "CONNECT_KEY_CONVERTER_SCHEMAS_ENABLE",
        "CONNECT_VALUE_CONVERTER",
        "CONNECT_VALUE_CONVERTER_SCHEMAS_ENABLE",
        "CONNECT_PLUGIN_PATH",
        "CONNECT_REST_ADVERTISED_HOST_NAME",
        "CONNECT_REST_PORT",
        "CONNECT_SECURITY_PROTOCOL",
        "CONNECT_SASL_MECHANISM",
        "CONNECT_SASL_JAAS_CONFIG",
        "CONNECT_SASL_CLIENT_CALLBACK_HANDLER_CLASS",
        "CONNECT_CUB_KAFKA_TIMEOUT",
        "KAFKA_HEAP_OPTS",
        "ASKLAKE_MSK_IAM_AUTH_JAR",
        "ASKLAKE_V2_SOURCE_TOPIC",
        "ASKLAKE_V2_DLQ_TOPIC"
      ],
      "requiredFileKeys": ["asklake-clickhouse-v2.properties", "clickhouse-v2-ca.crt"]
    },
    "backendRealtime": {
      "name": "asklake-realtime-runtime",
      "consumers": ["backend", "continuous-worker"],
      "keys": [
        "CLICKHOUSE_V2_MATERIALIZER_PASSWORD",
        "CLICKHOUSE_V2_READER_PASSWORD",
        "clickhouse-v2-ca.crt"
      ]
    }
  },
  "prohibited": [
    "static AWS access keys",
    "plaintext passwords in Helm values",
    "TLS private keys in Git",
    "one ClickHouse identity reused for admin, ingest, materializer, reader, migration, and observer"
  ]
}
