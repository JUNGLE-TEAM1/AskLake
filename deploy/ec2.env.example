# Copy this file to deploy/ec2.env or export the values in your shell.
# Do not commit deploy/ec2.env.

export AWS_REGION=ap-northeast-2

# EC2 instance id used by scripts/deploy.sh start/stop/deploy/status.
export ASKLAKE_EC2_INSTANCE_ID=i-xxxxxxxxxxxxxxxxx

# Optional but recommended. Use the Elastic IP, custom domain, or sslip.io host.
export ASKLAKE_EC2_HOST=asklake.example.com

# Public origin used by health checks. Do not include /api.
export ASKLAKE_APP_URL=https://asklake.example.com

export ASKLAKE_EC2_USER=ec2-user
export ASKLAKE_SSH_KEY="$HOME/.ssh/asklake-ec2.pem"
export ASKLAKE_DEPLOY_PATH=/opt/asklake
export ASKLAKE_DEPLOY_BRANCH=dev

# Must match the existing rollback stack's com.docker.compose.project label.
# Do not guess or silently adopt another project on the host.
export ASKLAKE_COMPOSE_PROJECT_NAME=asklake

# Usually keep these defaults unless the deploy layout changes.
export ASKLAKE_COMPOSE_FILE=deploy/docker-compose.prod.yml
export ASKLAKE_COMPOSE_ENV_FILE=deploy/.env
export ASKLAKE_HEALTH_PATH=/api/health
export ASKLAKE_HEALTH_RETRIES=18
export ASKLAKE_HEALTH_RETRY_DELAY=5
