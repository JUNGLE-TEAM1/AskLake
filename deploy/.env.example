# Copy this file to deploy/.env on the EC2 host and replace placeholder values.
# Do not commit deploy/.env.

COMPOSE_PROJECT_NAME=asklake

# Replace the example domain and credentials in deploy/.env before running the
# production preflight. APP_DOMAIN and VITE_API_BASE_URL must stay aligned.
# BACKEND_CORS_ORIGINS=https://asklake.example.com
#
# APP_DOMAIN is the Caddy site address. Use a bare domain for HTTPS, without https://.
APP_DOMAIN=asklake.example.com
HTTP_PORT=80
HTTPS_PORT=443

# Frontend build-time API origin. Do not include /api because the app appends /api paths.
VITE_API_BASE_URL=https://asklake.example.com
VITE_AUTH_LEGACY_DEMO_USERS_ENABLED=false
VITE_AUTH_PUBLIC_SIGNUP=false
VITE_USE_MOCK_API=false
VITE_DASHBOARD_ASSISTANT_API_PATH=/api/dashboards/assistant
VITE_OBJECT_STORAGE_PROVIDER=aws
VITE_S3_REGION=ap-northeast-2

APP_ENV=production
API_PREFIX=/api
# Demo-only opt-in. Set both legacy demo flags to true on the same deployment.
AUTH_LEGACY_DEMO_USERS_ENABLED=false
AUTH_PUBLIC_SIGNUP_ENABLED=false
BACKEND_CORS_ORIGINS=
BOOTSTRAP_ADMIN_EMAIL=replace-with-admin-email@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-bootstrap-password
BOOTSTRAP_ADMIN_DISPLAY_NAME=AskLake Administrator
DATABASE_CONNECT_TIMEOUT_SECONDS=5
LOCAL_LAKE_STORAGE_DIR=/var/lib/asklake/lake

# Legacy Dashboard Assistant compatibility. Query AI uses the isolated ai-server
# below; do not put provider keys in frontend env or the backend image settings.
OPENAI_API_KEY=
OPENAI_ASSISTANT_ENABLED=true
OPENAI_ASSISTANT_MODEL=gpt-4o-mini
OPENAI_ASSISTANT_MAX_OUTPUT_TOKENS=1200
OPENAI_ASSISTANT_MAX_SAMPLE_ROWS=5
OPENAI_ASSISTANT_TIMEOUT_SECONDS=20
OPENAI_QUERY_AI_MODEL=gpt-4.1-mini

# Query AI internal gateway. The gateway is reachable only on the Compose network.
AI_QUERY_PROVIDER=gateway
AI_GATEWAY_BASE_URL=http://ai-server:8090
AI_GATEWAY_GENERATE_PATH=/v1/generate
AI_GATEWAY_SERVICE_TOKEN=replace-with-strong-ai-gateway-service-token
AI_GATEWAY_TIMEOUT_SECONDS=30
AI_MCP_PATH=/internal/mcp
AI_MCP_SERVICE_TOKEN=replace-with-strong-ai-mcp-service-token
AI_CONTEXT_SIGNING_SECRET=replace-with-at-least-32-character-ai-context-secret
AI_CONTEXT_TTL_SECONDS=300
AI_CONTEXT_MAX_SAMPLE_ROWS=20

# Provider credentials live only in the ai-server container.
AI_PROVIDER=openai_compatible
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_API_KEY=replace-with-provider-api-key
AI_PROVIDER_MODEL=gpt-4.1-mini
AI_MCP_ENABLED=true
AI_MCP_SERVER_URL=http://backend:8080/internal/mcp
AI_MCP_TIMEOUT_SECONDS=10
AI_REQUEST_TIMEOUT_SECONDS=30

# Temporary row-by-row local LLM runtime for Review Row Analysis transforms.
# Set ASKLAKE_LOCAL_LLM_ENDPOINT_IN_DOCKER to the address reachable from Spark containers.
ASKLAKE_REVIEW_ANALYSIS_RUNTIME=local_llm
ASKLAKE_LOCAL_LLM_ENDPOINT=http://127.0.0.1:1234/v1/chat/completions
ASKLAKE_LOCAL_LLM_ENDPOINT_IN_DOCKER=http://host.docker.internal:1234/v1/chat/completions
ASKLAKE_LOCAL_LLM_MODEL=local-review-analyzer
ASKLAKE_LOCAL_LLM_TIMEOUT_SECONDS=120
ASKLAKE_LOCAL_LLM_MAX_INPUT_CHARS=9000

# Airflow orchestration. The prod Compose stack includes Airflow API server,
# scheduler, DAG processor, and Airflow metadata Postgres.
AIRFLOW_API_BASE_URL=http://airflow-apiserver:8080
AIRFLOW_DAG_ID=asklake_etl_job
AIRFLOW_UI_BASE_URL=
AIRFLOW_API_TOKEN=
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=replace-with-strong-airflow-password
AIRFLOW_REQUEST_TIMEOUT_SECONDS=10
AIRFLOW_RUN_SYNC_INTERVAL_SECONDS=5
# Shared only by the Airflow task and FastAPI. Replace this value on every server.
AIRFLOW_EXECUTION_API_TOKEN=replace-with-strong-airflow-execution-token
ASKLAKE_EXECUTION_API_TIMEOUT_SECONDS=7500
# Compatibility token for the existing `/api/etl/internal/airflow/...` endpoint.
AIRFLOW_INTERNAL_BASE_URL=http://backend:8080
AIRFLOW_INTERNAL_TOKEN=replace-with-strong-internal-token
AIRFLOW_INTERNAL_TIMEOUT_SECONDS=1800
AIRFLOW_IMAGE_NAME=apache/airflow:3.3.0
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=../airflow
# Required in deploy/.env: canonical urlsafe base64 for exactly 32 random bytes.
# python3 -c 'import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
AIRFLOW_FERNET_KEY=
AIRFLOW_API_AUTH_JWT_SECRET=replace-with-airflow-jwt-secret
AIRFLOW_API_AUTH_JWT_ISSUER=asklake
AIRFLOW_METADATA_DB_NAME=airflow
AIRFLOW_METADATA_DB_USER=airflow
# Use only unpadded base64url characters until the Compose connection URL is encoded.
AIRFLOW_METADATA_DB_PASSWORD=replace-with-strong-airflow-metadata-password

# Production Spark scripts are baked into the Spark runtime image. Create this
# durable root before deployment. spark-runtime-guard creates/repairs its Spark
# subdirectories with UID/GID 185 without deleting existing data.
ASKLAKE_HOST_DATA_DIR=/var/lib/asklake

# Trino/Iceberg query runtime. The coordinator keeps JDBC catalog metadata in
# AskLake Postgres and uses the EC2 instance role for warehouse/result S3 access.
# Keep both values empty/false for the compatibility deployment. To enable
# Trino, set TRINO_ENABLED=true and COMPOSE_PROFILES=trino, then fill every
# Trino secret, bucket, and TLS file below.
COMPOSE_PROFILES=
TRINO_ENABLED=false
TRINO_BASE_URL=https://trino:8443
TRINO_CATALOG=iceberg
TRINO_SCHEMA=asklake
TRINO_USER=asklake-api
TRINO_QUERY_TIMEOUT_SECONDS=300
TRINO_MAX_RESPONSE_BYTES=2000000
TRINO_MAX_RESULT_BYTES=50000000
TRINO_MAX_RESULT_PAGES=1000
TRINO_RESULT_RETENTION_SECONDS=86400
TRINO_MAX_CONCURRENT_RUNS_PER_USER=2
TRINO_RESULT_STORAGE_BUCKET=replace-with-asklake-query-results-bucket
TRINO_RESULT_STORAGE_PREFIX=query-results
TRINO_RESULT_STORAGE_AUTO_CREATE_BUCKET=false
TRINO_RESULT_CURSOR_SECRET=replace-with-a-long-random-production-secret
TRINO_QUERY_CONFIRMATION_SECRET=replace-with-a-long-random-production-secret
TRINO_QUERY_CONFIRMATION_TTL_SECONDS=300
TRINO_QUERY_WARNING_BYTES=1073741824
TRINO_QUERY_MAX_ESTIMATED_BYTES=0
TRINO_QUERY_ESTIMATED_THROUGHPUT_BYTES_PER_SECOND=268435456
TRINO_COLLECTOR_LEASE_SECONDS=60
TRINO_COLLECTOR_PAGES_PER_LEASE=100
TRINO_COLLECTOR_POLL_SECONDS=1
TRINO_CLEANUP_POLL_SECONDS=3600
TRINO_IMAGE=trinodb/trino:482
TRINO_AUTH_USERNAME=asklake-api
TRINO_AUTH_PASSWORD=replace-with-trino-backend-password
TRINO_MATERIALIZER_USERNAME=asklake-materializer
TRINO_MATERIALIZER_PASSWORD=replace-with-trino-materializer-password
TRINO_TLS_CA_FILE=
TRINO_TLS_CA_CONTAINER_FILE=
TRINO_TLS_KEYSTORE_FILE=/opt/asklake/secrets/trino-keystore.jks
TRINO_TLS_KEYSTORE_PASSWORD=replace-with-trino-keystore-password
TRINO_PASSWORD_FILE=/opt/asklake/secrets/trino-password.db
TRINO_INTERNAL_SHARED_SECRET=replace-with-base64-trino-shared-secret
TRINO_ICEBERG_CATALOG_NAME=asklake
TRINO_ICEBERG_JDBC_USER=asklake_trino
TRINO_ICEBERG_JDBC_PASSWORD=replace-with-trino-jdbc-password
TRINO_ICEBERG_WAREHOUSE_BUCKET=replace-with-asklake-warehouse-bucket
TRINO_ICEBERG_WAREHOUSE_PREFIX=warehouse
ASKLAKE_SPARK_IMAGE=apache/spark:4.0.1
ASKLAKE_SPARK_HADOOP_AWS_PACKAGE=org.apache.hadoop:hadoop-aws:3.4.1
ASKLAKE_SPARK_ICEBERG_PACKAGE=org.apache.iceberg:iceberg-spark-runtime-4.0_2.13:1.11.0
ASKLAKE_SPARK_POSTGRES_PACKAGE=org.postgresql:postgresql:42.7.7
# Spark 4.0.1 is built for Scala 2.13. The continuous worker combines this
# connector with the S3A package above when it launches a streaming query.
ASKLAKE_SPARK_KAFKA_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.13:4.0.1
ASKLAKE_SPARK_OUTPUT_MODE=s3a
ASKLAKE_SPARK_OUTPUT_BUCKET=replace-with-asklake-output-bucket
ASKLAKE_SPARK_OUTPUT_PREFIX=asklake-output
# 0 means no execution cap. Set a positive value only for a debug run.
ASKLAKE_SPARK_RUN_ROW_LIMIT=0
ASKLAKE_SPARK_RUN_TIMEOUT_SECONDS=7200
ASKLAKE_SPARK_REST_POLL_INTERVAL_MS=1000
ASKLAKE_SPARK_DRIVER_CORES=1
ASKLAKE_SPARK_DRIVER_MEMORY=1g
ASKLAKE_SPARK_EXECUTOR_CORES=2
ASKLAKE_SPARK_EXECUTOR_MEMORY=4g
ASKLAKE_SPARK_CORES_MAX=2
ASKLAKE_SPARK_WORKER_CORES=4
ASKLAKE_SPARK_WORKER_MEMORY=10g
ASKLAKE_SPARK_MAX_DRIVERS=2
ASKLAKE_SOURCE_INSPECT_TIMEOUT_MS=90000
ASKLAKE_KAFKA_BROKER=redpanda:9092
ASKLAKE_SOURCE_DEFAULT_KAFKA_TOPIC=asklake-source-events
ASKLAKE_KAFKA_SAMPLE_TIMEOUT_MS=8000
ASKLAKE_KAFKA_SAMPLE_IDLE_MS=500
ASKLAKE_KAFKA_SAMPLE_MIN_MESSAGES=3
ASKLAKE_KAFKA_SAMPLE_SETTLE_MS=1500
# Optional read-only host directory for on-demand Kafka replay inputs.
# The default fixture remains inside the backend image; set inputPath only for files in this directory.
ASKLAKE_REPLAY_HOST_INPUT_DIR=/var/lib/asklake/replay-input
ASKLAKE_REPLAY_INPUT_DIR=/var/lib/asklake/replay-input
CONTINUOUS_RUNTIME_SYNC_INTERVAL_SECONDS=1
DASHBOARD_SYNC_MODE=polling
REALTIME_EVENTS_ENABLED=false
CONTINUOUS_SQL_JOIN_ENABLED=false
LATEST_STATIC_PER_BATCH_ENABLED=false
STATIC_CHANGE_BACKFILL_ENABLED=false
CONTINUOUS_SQL_STATIC_BROADCAST_MAX_ROWS=100000
CONTINUOUS_SQL_STATIC_CACHE_MAX_ROWS=5000000
CONTINUOUS_SQL_MAX_OUTPUT_ROWS_PER_INPUT=10
CLICKHOUSE_CONTINUOUS_JOIN_ENABLED=false
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.8.28.1
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=asklake
CLICKHOUSE_PASSWORD=replace-with-clickhouse-password
CLICKHOUSE_DATABASE=asklake
CLICKHOUSE_QUERY_TIMEOUT_SECONDS=15
CLICKHOUSE_STATIC_LOAD_MAX_ROWS=15000000
CLICKHOUSE_INSERT_BATCH_ROWS=5000
REALTIME_EVENT_RETENTION_SECONDS=86400
REALTIME_EVENT_PAYLOAD_MAX_BYTES=8192
REALTIME_REPLAY_LIMIT=500
REALTIME_SUBSCRIBER_QUEUE_SIZE=128
REALTIME_CONNECTION_LIMIT_PER_ACTOR=5
REALTIME_HEARTBEAT_SECONDS=15
REALTIME_DISPATCH_POLL_SECONDS=0.5
REALTIME_CLEANUP_INTERVAL_SECONDS=3600
REALTIME_SSE_SEND_TIMEOUT_SECONDS=10
# Maximum unacknowledged publication manifests exposed in one worker report.
ASKLAKE_CONTINUOUS_PUBLICATION_WINDOW=100
ASKLAKE_CONTINUOUS_MAINTENANCE_LEASE_SECONDS=900
# Low-latency Continuous jobs use a small shuffle width independently of large batch jobs.
ASKLAKE_CONTINUOUS_SPARK_SHUFFLE_PARTITIONS=4
ASKLAKE_CONTINUOUS_SPARK_LOG_LEVEL=WARN
# Runner heartbeat older than this is considered stale after the DB lease expires.
ASKLAKE_CONTINUOUS_MAINTENANCE_RUNNER_STALE_SECONDS=30
# Test harness only. Keep false in deployed environments.
ASKLAKE_CONTINUOUS_FAIL_AFTER_DATA_WRITE_ONCE=false

# Production object storage. Do not add long-lived AWS access keys here.
# The backend, Spark, and DuckDB use the EC2 instance IAM Role.
ASKLAKE_OBJECT_STORAGE_PROVIDER=aws
AWS_REGION=ap-northeast-2
ASKLAKE_RAW_BUCKET=replace-with-asklake-raw-bucket
# Optional non-secret defaults for a brand-new Source draft. An empty bucket
# uses ASKLAKE_RAW_BUCKET; leave the prefix empty to start at the bucket root.
ASKLAKE_SOURCE_DEFAULT_S3_BUCKET=
ASKLAKE_SOURCE_DEFAULT_S3_PREFIX=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ALLOWED_BUCKETS=replace-with-asklake-raw-bucket,replace-with-asklake-output-bucket
ASKLAKE_S3_READINESS_READ_BUCKETS=replace-with-asklake-raw-bucket
ASKLAKE_S3_READINESS_WRITE_BUCKETS=replace-with-asklake-output-bucket
ASKLAKE_SQL_PREVIEW_MAX_REMOTE_BYTES=536870912

POSTGRES_DB=asklake_metadata
POSTGRES_USER=asklake
# Use a URL-safe value because Compose interpolates this into DATABASE_URL.
POSTGRES_PASSWORD=replace-with-strong-postgres-password

MONGO_INITDB_DATABASE=asklake_sources
MONGO_INITDB_ROOT_USERNAME=asklake
MONGO_INITDB_ROOT_PASSWORD=replace-with-strong-mongo-password
