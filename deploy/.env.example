# Copy this file to deploy/.env on the EC2 host and replace placeholder values.
# Do not commit deploy/.env.

COMPOSE_PROJECT_NAME=asklake

# Replace the example domain and credentials in deploy/.env before running the
# production preflight. APP_DOMAIN and VITE_API_BASE_URL must stay aligned.
# BACKEND_CORS_ORIGINS=https://asklake.example.com
#
# APP_DOMAIN is the Caddy site address. Use a bare domain for HTTPS, without https://.
APP_DOMAIN=asklake.example.com
HTTP_PORT=80
HTTPS_PORT=443

# Frontend build-time API origin. Do not include /api because the app appends /api paths.
VITE_API_BASE_URL=https://asklake.example.com
VITE_AUTH_PUBLIC_SIGNUP=false
VITE_USE_MOCK_API=false
VITE_DASHBOARD_ASSISTANT_API_PATH=/api/dashboards/assistant
VITE_OBJECT_STORAGE_PROVIDER=aws
VITE_S3_REGION=ap-northeast-2

APP_ENV=production
API_PREFIX=/api
AUTH_PUBLIC_SIGNUP_ENABLED=false
BACKEND_CORS_ORIGINS=
BOOTSTRAP_ADMIN_EMAIL=replace-with-admin-email@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-bootstrap-password
BOOTSTRAP_ADMIN_DISPLAY_NAME=AskLake Administrator
DATABASE_CONNECT_TIMEOUT_SECONDS=5
LOCAL_LAKE_STORAGE_DIR=/var/lib/asklake/lake

# Optional OpenAI-backed assistant features. Keep OPENAI_API_KEY only in deploy/.env.
OPENAI_API_KEY=
OPENAI_ASSISTANT_ENABLED=true
OPENAI_ASSISTANT_MODEL=gpt-4o-mini
OPENAI_ASSISTANT_MAX_OUTPUT_TOKENS=1200
OPENAI_ASSISTANT_MAX_SAMPLE_ROWS=5
OPENAI_ASSISTANT_TIMEOUT_SECONDS=20
OPENAI_QUERY_AI_MODEL=gpt-4.1-mini

# Temporary row-by-row local LLM runtime for Review Row Analysis transforms.
# Set ASKLAKE_LOCAL_LLM_ENDPOINT_IN_DOCKER to the address reachable from Spark containers.
ASKLAKE_REVIEW_ANALYSIS_RUNTIME=local_llm
ASKLAKE_LOCAL_LLM_ENDPOINT=http://127.0.0.1:1234/v1/chat/completions
ASKLAKE_LOCAL_LLM_ENDPOINT_IN_DOCKER=http://host.docker.internal:1234/v1/chat/completions
ASKLAKE_LOCAL_LLM_MODEL=local-review-analyzer
ASKLAKE_LOCAL_LLM_TIMEOUT_SECONDS=120
ASKLAKE_LOCAL_LLM_MAX_INPUT_CHARS=9000

# Airflow orchestration. The prod Compose stack includes Airflow API server,
# scheduler, DAG processor, and Airflow metadata Postgres.
AIRFLOW_API_BASE_URL=http://airflow-apiserver:8080
AIRFLOW_DAG_ID=asklake_etl_job
AIRFLOW_UI_BASE_URL=
AIRFLOW_API_TOKEN=
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=replace-with-strong-airflow-password
AIRFLOW_REQUEST_TIMEOUT_SECONDS=10
# Shared only by the Airflow task and FastAPI. Replace this value on every server.
AIRFLOW_EXECUTION_API_TOKEN=replace-with-strong-airflow-execution-token
ASKLAKE_EXECUTION_API_TIMEOUT_SECONDS=7500
# Compatibility token for the existing `/api/etl/internal/airflow/...` endpoint.
AIRFLOW_INTERNAL_BASE_URL=http://backend:8080
AIRFLOW_INTERNAL_TOKEN=replace-with-strong-internal-token
AIRFLOW_INTERNAL_TIMEOUT_SECONDS=1800
AIRFLOW_IMAGE_NAME=apache/airflow:3.3.0
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=../airflow
# Required in deploy/.env: canonical urlsafe base64 for exactly 32 random bytes.
# python3 -c 'import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
AIRFLOW_FERNET_KEY=
AIRFLOW_API_AUTH_JWT_SECRET=replace-with-airflow-jwt-secret
AIRFLOW_API_AUTH_JWT_ISSUER=asklake
AIRFLOW_METADATA_DB_NAME=airflow
AIRFLOW_METADATA_DB_USER=airflow
# Use only unpadded base64url characters until the Compose connection URL is encoded.
AIRFLOW_METADATA_DB_PASSWORD=replace-with-strong-airflow-metadata-password

# Production Spark scripts are baked into the Spark runtime image. Create
# spark-ivy, spark-output, spark-runs, samples, and review-text-models under this
# durable host directory before deployment; spark-dir-init assigns UID/GID 185.
ASKLAKE_HOST_DATA_DIR=/var/lib/asklake
ASKLAKE_SPARK_IMAGE=apache/spark:4.0.1
ASKLAKE_SPARK_HADOOP_AWS_PACKAGE=org.apache.hadoop:hadoop-aws:3.4.1
# Spark 4.0.1 is built for Scala 2.13. The continuous worker combines this
# connector with the S3A package above when it launches a streaming query.
ASKLAKE_SPARK_KAFKA_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.13:4.0.1
ASKLAKE_SPARK_OUTPUT_MODE=s3a
ASKLAKE_SPARK_OUTPUT_BUCKET=replace-with-asklake-output-bucket
ASKLAKE_SPARK_OUTPUT_PREFIX=asklake-output
# 0 means no execution cap. Set a positive value only for a debug run.
ASKLAKE_SPARK_RUN_ROW_LIMIT=0
ASKLAKE_SPARK_RUN_TIMEOUT_SECONDS=7200
ASKLAKE_SPARK_REST_POLL_INTERVAL_MS=1000
ASKLAKE_SPARK_DRIVER_CORES=1
ASKLAKE_SPARK_DRIVER_MEMORY=1g
ASKLAKE_SPARK_EXECUTOR_CORES=2
ASKLAKE_SPARK_EXECUTOR_MEMORY=4g
ASKLAKE_SPARK_CORES_MAX=2
ASKLAKE_SPARK_WORKER_CORES=4
ASKLAKE_SPARK_WORKER_MEMORY=10g
ASKLAKE_SPARK_MAX_DRIVERS=2
ASKLAKE_SOURCE_INSPECT_TIMEOUT_MS=90000
ASKLAKE_KAFKA_BROKER=redpanda:9092
ASKLAKE_KAFKA_SAMPLE_TIMEOUT_MS=8000
ASKLAKE_KAFKA_SAMPLE_IDLE_MS=500
ASKLAKE_KAFKA_SAMPLE_MIN_MESSAGES=3
ASKLAKE_KAFKA_SAMPLE_SETTLE_MS=1500
# Optional read-only host directory for on-demand Kafka replay inputs.
# The default fixture remains inside the backend image; set inputPath only for files in this directory.
ASKLAKE_REPLAY_HOST_INPUT_DIR=/var/lib/asklake/replay-input
ASKLAKE_REPLAY_INPUT_DIR=/var/lib/asklake/replay-input
CONTINUOUS_RUNTIME_SYNC_INTERVAL_SECONDS=5
ASKLAKE_CONTINUOUS_MAINTENANCE_LEASE_SECONDS=900
# Test harness only. Keep false in deployed environments.
ASKLAKE_CONTINUOUS_FAIL_AFTER_DATA_WRITE_ONCE=false

# Production object storage. Do not add long-lived AWS access keys here.
# The backend, Spark, and DuckDB use the EC2 instance IAM Role.
ASKLAKE_OBJECT_STORAGE_PROVIDER=aws
AWS_REGION=ap-northeast-2
ASKLAKE_RAW_BUCKET=replace-with-asklake-raw-bucket
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ALLOWED_BUCKETS=replace-with-asklake-raw-bucket,replace-with-asklake-output-bucket
ASKLAKE_S3_READINESS_READ_BUCKETS=replace-with-asklake-raw-bucket
ASKLAKE_S3_READINESS_WRITE_BUCKETS=replace-with-asklake-output-bucket
ASKLAKE_SQL_PREVIEW_MAX_REMOTE_BYTES=536870912

POSTGRES_DB=asklake_metadata
POSTGRES_USER=asklake
# Use a URL-safe value because Compose interpolates this into DATABASE_URL.
POSTGRES_PASSWORD=replace-with-strong-postgres-password

MONGO_INITDB_DATABASE=asklake_sources
MONGO_INITDB_ROOT_USERNAME=asklake
MONGO_INITDB_ROOT_PASSWORD=replace-with-strong-mongo-password
