<clickhouse>
    <!-- Production mounts this file in addition to keeper.xml. Plaintext HTTP
         is removed here. tcp_port remains available only to the entrypoint's
         loopback-bound bootstrap server; Compose disables it for final exec. -->
    <http_port remove="remove"/>
    <https_port>8443</https_port>
    <tcp_port_secure>9440</tcp_port_secure>
    <!-- ReplicatedMergeTree still needs an interserver endpoint after the
         plaintext listener is removed. Keep it private to the Compose network
         and use the same server certificate as the public TLS listeners. -->
    <interserver_http_port remove="remove"/>
    <interserver_https_port>9010</interserver_https_port>
    <openSSL>
        <server>
            <certificateFile>/run/asklake-clickhouse-v2-secrets/server.crt</certificateFile>
            <privateKeyFile>/run/asklake-clickhouse-v2-secrets/server.key</privateKeyFile>
            <caConfig>/run/asklake-clickhouse-v2-secrets/ca.crt</caConfig>
            <verificationMode>none</verificationMode>
            <loadDefaultCAFile>true</loadDefaultCAFile>
            <cacheSessions>true</cacheSessions>
            <disableProtocols>sslv2,sslv3,tlsv1,tlsv1_1</disableProtocols>
            <preferServerCiphers>true</preferServerCiphers>
        </server>
    </openSSL>
</clickhouse>
