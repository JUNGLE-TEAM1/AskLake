{
  "catalogs": [
    {
      "user": "asklake-materializer",
      "catalog": "iceberg",
      "allow": "all"
    },
    {
      "user": "asklake-api",
      "catalog": "iceberg",
      "allow": "read-only"
    }
  ],
  "tables": [
    {
      "user": "asklake-materializer",
      "catalog": "iceberg",
      "schema": "asklake",
      "table": ".*",
      "privileges": ["SELECT", "INSERT", "DELETE", "UPDATE", "OWNERSHIP"]
    },
    {
      "user": "asklake-api",
      "catalog": "iceberg",
      "schema": "asklake",
      "table": ".*",
      "privileges": ["SELECT"]
    }
  ],
  "schemas": [
    {
      "user": "asklake-materializer",
      "schema": "asklake",
      "owner": true
    }
  ],
  "queries": [
    {
      "user": "asklake-materializer",
      "allow": ["execute"]
    },
    {
      "user": "asklake-api",
      "allow": ["execute"]
    }
  ],
  "functions": []
}
