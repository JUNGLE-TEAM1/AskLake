# Optional. Omit this in local dev to use the Vite /api proxy.
# VITE_API_BASE_URL=http://localhost:8080

# Optional. Local source connector requests use port 8080 by default.
# Override this when validating against another local backend worktree.
# VITE_BACKEND_DIRECT_URL=http://127.0.0.1:8080

# Optional. The default is false, which uses the live backend through the Vite /api proxy.
# Set true only for frontend-only mock QA.
# VITE_USE_MOCK_API=false

# Production legacy demo login is hidden by default. Enable only when the backend
# also sets AUTH_LEGACY_DEMO_USERS_ENABLED=true.
# VITE_AUTH_LEGACY_DEMO_USERS_ENABLED=false

# Production signup is hidden by default. Enable only when the backend also
# sets AUTH_PUBLIC_SIGNUP_ENABLED=true.
# VITE_AUTH_PUBLIC_SIGNUP=false

# Optional. The default is /api/dashboards/assistant.
# Override this only when the Assistant API is hosted at a different path or origin.
# VITE_DASHBOARD_ASSISTANT_API_PATH=/api/dashboards/assistant

# Local development uses MinIO. Production Compose builds the frontend with aws.
VITE_OBJECT_STORAGE_PROVIDER=minio
VITE_S3_REGION=us-east-1
