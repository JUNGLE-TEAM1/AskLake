APP_ENV=local
INTERNAL_AUTH_TOKEN=replace-with-a-long-random-service-token

# Live provider. PROVIDER=mock is rejected outside test/testing.
PROVIDER=openai_compatible
PROVIDER_BASE_URL=https://api.openai.com/v1
PROVIDER_API_KEY=
PROVIDER_MODEL=gpt-4.1
PROVIDER_MODEL_QUERY_SQL=gpt-4.1
PROVIDER_MODEL_DASHBOARD_ASSISTANT=gpt-4.1
PROVIDER_MODEL_ETL_TRANSFORM=gpt-4.1
PROVIDER_MODEL_RAG=gpt-4.1
PROVIDER_MODEL_REVIEW=gpt-4.1

# Optional OpenAI-compatible failover provider.
PROVIDER_FALLBACK_BASE_URL=
PROVIDER_FALLBACK_API_KEY=
PROVIDER_FALLBACK_MODEL=
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_RETRY_BASE_SECONDS=0.25
PROVIDER_HEALTHCHECK_ENABLED=true
PROVIDER_HEALTHCHECK_PATH=/models
PROVIDER_INPUT_COST_PER_MILLION_TOKENS=0
PROVIDER_OUTPUT_COST_PER_MILLION_TOKENS=0

# Permission-scoped AskLake Catalog context.
MCP_ENABLED=true
MCP_SERVER_URL=http://127.0.0.1:8080/internal/mcp
MCP_SERVICE_TOKEN=replace-with-the-backend-mcp-token
MCP_TIMEOUT_SECONDS=10
CONTEXT_REPLAY_MAX_ENTRIES=10000
CONTEXT_REPLAY_TTL_SECONDS=300

REQUEST_TIMEOUT_SECONDS=30
MAX_OUTPUT_TOKENS=1800
MAX_PROVIDER_RESPONSE_BYTES=1048576
MAX_EMBEDDING_PROVIDER_RESPONSE_BYTES=8388608
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
